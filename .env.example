# TicketFlow environment variables.
# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit .env. Only the variables below are allowed: the settings class
# (schemas.py) rejects unknown keys, so do not add extra variables here.

# Secret used to sign JWT access tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Algorithm used to sign and verify JWT access tokens.
ALGORITHM=HS256

# PostgreSQL connection string (SQLAlchemy + psycopg2).
# This value is used when running the app on your machine against the Compose database (port 5435).
# docker compose overrides it for the web container.
DATABASE_URL=postgresql+psycopg2://postgres:<password>@localhost:5435/ticketflow

# Redis connection string, used for caching.
# This value is used when running the app on your machine against the Compose Redis (port 6380).
# docker compose overrides it for the web container.
REDIS_URL=redis://localhost:6380/0

# Mistral API key for the /ask policy assistant (embeddings + chat).
# Create one at https://console.mistral.ai. The tests mock Mistral, so any value works for pytest.
MISTRAL_API_KEY=your-mistral-api-key
